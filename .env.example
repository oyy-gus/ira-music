# ==============================================================================
# 🎵 IRA MUSIC & ATLANTIS BOT — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and fill in your credentials.
# Do NOT commit your actual '.env' file to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 🤖 DISCORD BOT CREDENTIALS
# ------------------------------------------------------------------------------
# Discord Developer Portal: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Bot Owner's Discord User ID (required for developer commands: *eval, *reload, *shutdown, *botban, etc.)
OWNER_ID=your_discord_user_id

# Default prefix for Discord text commands (default: *)
DEFAULT_PREFIX=*

# Optional Custom Links
BOT_INVITE_URL=
SUPPORT_SERVER_URL=https://discord.gg/vabruGDuAe

# ------------------------------------------------------------------------------
# 🌐 WEB DASHBOARD & OAUTH2 SETTINGS
# ------------------------------------------------------------------------------
# Set to 'false' to disable the embedded web server
WEB_ENABLED=true

# HTTP Port for Web Dashboard & REST API
PORT=3000

# OAuth2 Redirect URI (Must match the redirect URI registered in Discord Dev Portal)
# Example: http://localhost:3000/auth/discord/callback or https://yourdomain.com/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# ------------------------------------------------------------------------------
# 🗄️ DATABASE (MONGODB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (Atlas Cloud Cluster or local MongoDB instance)
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority
# Local format: mongodb://127.0.0.1:27017/ira-music
MONGODB_URI=mongodb://127.0.0.1:27017/ira-music

# ------------------------------------------------------------------------------
# 🔊 LAVALINK CLUSTER CONFIGURATION (Music Streaming Engine)
# ------------------------------------------------------------------------------
# Option 1: Multi-node cluster as a JSON array string (Recommended for production):
LAVALINK_NODES=[{"id":"main-node","host":"127.0.0.1","port":2333,"authorization":"youshallnotpass","secure":false,"retryAmount":5,"retryDelay":5000,"region":"US"}]

# Option 2: Single node fallback parameters (used if LAVALINK_NODES is not specified)
# LAVALINK_ID=Local-Node
# LAVALINK_HOST=127.0.0.1
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=youshallnotpass
# LAVALINK_SECURE=false
# LAVALINK_RETRY_AMOUNT=5
# LAVALINK_RETRY_DELAY=5000
# LAVALINK_REGION=US

# ------------------------------------------------------------------------------
# 📢 DISCORD WEBHOOK LOGGING (Optional)
# ------------------------------------------------------------------------------
# Discord Webhook URLs for real-time channel logs & audit trails
WEBHOOK_SYSTEM_URL=
WEBHOOK_INVITE_URL=
WEBHOOK_COMMAND_URL=
WEBHOOK_MUSIC_URL=

# ------------------------------------------------------------------------------
# ⚙️ APPLICATION RUNTIME
# ------------------------------------------------------------------------------
# Environment: 'development' or 'production' or 'test'
NODE_ENV=development

# Logging level: 'error', 'warn', 'info', 'http', 'verbose', 'debug', 'silly'
LOG_LEVEL=info
